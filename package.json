  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --import ./src/instrumentation.ts src/index.ts",
    "containers:up": "docker compose up grafana -d",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsc",
