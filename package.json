    "pods:apply": "kubectl apply -k k8s/",
    "pods:kill": "kubectl delete -k k8s/",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
